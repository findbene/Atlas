# Atlas — local environment template. Copy to `.env` (gitignored) and fill in.
# NEVER commit real secrets. `.env` is ignored by .gitignore.
#
# Required to run the DB-gated audits + seed locally (Phase 0.x local-green):
#   pnpm --filter @workspace/scripts run audit:authoring
#   pnpm --filter @workspace/scripts run audit:csv-set-equal-bc
#   pnpm --filter @workspace/scripts run audit:contains-bc
#
# Use a Neon branch connection string (or any reachable Postgres for the local
# baseline). The DB must be migrated + seeded for the csv_set_equal / contains
# BC audits to query real catalog rows.
DATABASE_URL=

# Other secrets the app reads from env at deploy time (not needed for the
# DB-gated audits above; listed for completeness):
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# STRIPE_SECRET_KEY=
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# RUN_ENVELOPE_SIGNING_SECRET=
